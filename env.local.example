# Supabase 대시보드 → Project Settings → API
# 이 파일을 복사해 `.env.local` 로 저장한 뒤 값을 채우세요.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Vercel (birdy-garden.vercel.app) 배포 시 필수:
# 1. Vercel → Project → Settings → Environment Variables 에 위 두 값 추가
# 2. 저장 후 Deployments → Redeploy (환경 변수 넣은 뒤 반드시 재배포)
#
# Supabase 대시보드:
# - Authentication → URL Configuration → Site URL: https://birdy-garden.vercel.app
# - Authentication → Providers → Email → Confirm email 끄기
# - SQL Editor에서 supabase/schema.sql 실행

# Supabase 대시보드 → Project Settings → API
# 이 파일을 복사해 `.env.local` 로 저장한 뒤 값을 채우세요.
# Vercel 배포 시에도 동일한 변수를 Environment Variables에 넣어야 합니다.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# 회원가입이 안 될 때 Supabase 대시보드에서 확인:
# Authentication → Providers → Email → "Confirm email" 끄기
# Authentication → Sign In / Providers → Email 활성화
